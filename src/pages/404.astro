---
/* WHAT THIS FILE DOES: the "page not found" page people see if they type a wrong address. */
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found" description="This page could not be found.">
  <section class="section">
    <div class="container">
      <h1>Page not found</h1>
      <p class="lead">Sorry, we could not find that page.</p>
      <div class="actions"><a class="btn" href="/">Go to the home page</a></div>
    </div>
  </section>
</BaseLayout>
