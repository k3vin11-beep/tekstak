---
/* WHAT THIS FILE DOES: the CONTACT page (address: /contact/): the contact form and the email address.
   The form emails the business AND opens a WhatsApp chat (see src/components/ContactForm.astro). */
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import site from "../config/site";
---
<BaseLayout
  title="Contact"
  description={`Contact ${site.name} for a website quote. Send a message and we will reply by email and WhatsApp.`}
  breadcrumbs={[{ name: "Contact", path: "/contact/" }]}
>
  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Get a quote</h1>
        <p class="lead">Tell us about your business and what you need. We will get back to you.</p>
        <p class="muted">When you press send, your message is emailed to us and WhatsApp opens with it ready to send, so we can chat straight away.</p>
        <p style="margin-top: 28px;">
          <strong>Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a><br />
          <strong>Based in:</strong> {site.address}
        </p>
      </div>
      <div class="card">
        <h2>Send us a message</h2>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
