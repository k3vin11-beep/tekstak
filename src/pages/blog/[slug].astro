---
/* WHAT THIS FILE DOES: one blog POST page (address: /blog/your-post-name/).
   Astro builds one of these for every file in src/content/blog automatically (that is what getStaticPaths does).
   It adds Article schema markup so Google knows the headline, date and author. */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Img from "../../components/Img.astro";
import JsonLd from "../../components/JsonLd.astro";
import { posts, slugify, formatDate } from "../../lib/blog";
import { articleSchema } from "../../lib/schema";
import { getImage } from "../../lib/images";
import site from "../../config/site";

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = post;
const related = posts.filter((p) => p.category === post.category && p.slug !== post.slug).slice(0, 2);
// the cover photo is also used as the picture when the post is shared on WhatsApp or Facebook
const cover = getImage(post.image);
---
<BaseLayout
  title={post.title}
  description={post.description}
  ogType="article"
  ogImage={cover.src}
  breadcrumbs={[{ name: "Blog", path: "/blog/" }, { name: post.title, path: `/blog/${post.slug}/` }]}
>
  <JsonLd slot="head" data={articleSchema({ title: post.title, description: post.description, date: post.date, slug: post.slug, author: post.author, imageUrl: new URL(cover.src, site.url).href })} />
  <section class="section">
    <div class="container">
      <article class="article">
        <p class="breadcrumbs"><a href="/blog/">Blog</a> / <a href={`/blog/category/${slugify(post.category)}/`}>{post.category}</a></p>
        <h1>{post.title}</h1>
        <p class="post-meta">{formatDate(post.date)}{post.author && ` · ${post.author}`}</p>
        <Img src={post.image} alt={post.imageAlt} width={1000} widths={[500, 800, 1000]} sizes="(max-width: 860px) 100vw, 760px" loading="eager" fetchpriority="high" />
        <div class="prose"><Content /></div>

        {related.length > 0 && (
          <>
            <h2 style="margin-top: 48px;">More from the blog</h2>
            <ul>{related.map((r) => <li><a href={`/blog/${r.slug}/`}>{r.title}</a></li>)}</ul>
          </>
        )}
        <div class="cta-band" style="margin-top: 48px;">
          <h2>Need help?</h2>
          <p>Send us a message and we will get back to you.</p>
          <a class="btn" href="/contact/">Contact us</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
